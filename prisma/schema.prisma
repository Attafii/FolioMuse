// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Gallery Curation Models ──────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            String    @default("USER") // USER | ADMIN
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  submissions     Submission[]
  newsletters     Newsletter[]
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  token           String    @unique
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Submission {
  id              String    @id @default(cuid())
  url             String
  creatorName     String
  creatorRole     String
  email           String?
  notes           String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  userId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

model Newsletter {
  id              String    @id @default(cuid())
  email           String    @unique
  userId          String?
  subscribedAt    DateTime  @default(now())
  unsubscribedAt  DateTime?

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Attribution {
  id           String        @id @default(cuid())
  creatorName  String
  sourceUrl    String        @unique
  licenseType  String
  consentDate  DateTime
  createdAt    DateTime      @default(now())
  galleryItems GalleryItem[]

  // ADR-0003 D1/D5: canonical creator link (nullable rollout; explicit only)
  creator   Creator? @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId String?

  @@index([creatorId])
}

model ConsentRecord {
  id           String        @id @default(cuid())
  tier         String
  consentedBy  String
  consentedAt  DateTime
  terms        String
  expiresAt    DateTime?
  // ADR-0003 D3: revocation timestamp; original grant row is preserved
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())
  galleryItems GalleryItem[]
}

model GalleryItem {
  id                  String            @id @default(cuid())
  title               String
  creatorRole         String
  profession          String?           @default("GENERAL")
  styleTags           String[]          @default([])
  qualityLevel        String?
  complianceStatus    String?
  status              String            @default("PENDING_REVIEW")
  attributionId       String
  consentRecordId     String
  reviewedAt          DateTime?
  duplicateOfId       String?
  structureFingerprint String?
  contentHash         String?
  // Portfolio card system (ADR-0006): curated external screenshot reference +
  // bounded stack metadata. Additive nullable/default rollout (ADR-0003 D2) -
  // legacy rows stay null/[] until curated. Never raw content.
  mediaUrl            String?
  stackTags           String[]        @default([])
  // Portfolio detail safe reference (ADR-0007 D3): bounded curated metadata
  // for /gallery/[id]. Null/empty until curated - no guessed backfill. JSON
  // columns hold validated descriptors only, never raw content/structure.
  desktopMediaUrl     String?
  mobileMediaUrl      String?
  // Public source repository when the portfolio is open source (verified
  // via GitHub API before seeding). Nullable; display-only reference.
  githubUrl           String?
  pageIndex           String[]        @default([])
  sections            Json?
  strengths           Json?
  stackEvidence       Json?
  // ADR-0003 D1/D4: nullable provenance rollout relations
  sourceRecordId      String?           @unique
  aiProvenanceId      String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  attribution   Attribution    @relation(fields: [attributionId], references: [id])
  consent       ConsentRecord  @relation(fields: [consentRecordId], references: [id])
  sourceRecord  SourceRecord?  @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  aiProvenance  AiProvenance?  @relation(fields: [aiProvenanceId], references: [id], onDelete: Restrict)
  sectionRecords SectionRecord[]
  auditEntries  AuditEntry[]
  reviewDecisions ReviewDecision[]
  ownershipClaims OwnershipClaim[]
  removalRecords   RemovalRecord[]
  supersedingAssertions SupersedingAssertion[]
  behaviorEvents   BehaviorEvent[]
  rankingScore     RankingScore?

  @@index([status])
  @@index([creatorRole])
}

model AuditEntry {
  id        String       @id @default(cuid())
  action    String
  actorId   String
  itemId    String?
  decision  String?
  rationale String?
  timestamp DateTime     @default(now())

  item      GalleryItem? @relation(fields: [itemId], references: [id])
}

model ReviewDecision {
  id                String       @id @default(cuid())
  itemId            String
  decision          String
  qualityLevel      String
  complianceStatus  String
  rejectionReason   String?
  rationale         String
  reviewerId        String
  appealedAt        DateTime?
  appealDecision    String?
  createdAt         DateTime     @default(now())

  item              GalleryItem  @relation(fields: [itemId], references: [id])
}

model PatternSignal {
  id                  String    @id @default(cuid())
  derivedFromItemIds  String[]
  patternType         String
  staleSince          DateTime?
  // ADR-0003 D8: eligibility floor + rebuild state
  eligibleItemCount   Int?
  distinctCreatorCount Int?
  rebuildState        String?   // STALE_PENDING_REBUILD | REBUILDING | ACTIVE | REBUILD_FAILED | DROPPED_BELOW_FLOOR
  createdAt           DateTime  @default(now())

  behaviorEvents BehaviorEvent[]
  signalScore    SignalScore?

  @@index([rebuildState, staleSince])
}

// ── Data Flywheel Models (ADR-0004) ──────────────────────────────────────

model BehaviorEvent {
  id              String    @id @default(cuid())
  eventType       String    // IMPRESSION | OPEN | SAVE | COLLECTION_ADD | MCP_RETRIEVAL_USE | DISMISSAL | REFORMULATION | MODERATOR_ACCEPTANCE
  // Privacy: subject is identified only by a SHA-256 hash of a stable
  // anonymous id — never a raw identifier (ADR-0004 D1, policy §12).
  subjectKey      String
  itemId          String?
  patternSignalId String?
  experimentId    String?
  variant         String?
  occurredAt      DateTime
  idempotencyKey  String    @unique
  payload         Json      @default("{}")
  createdAt       DateTime  @default(now())

  item          GalleryItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  patternSignal PatternSignal?  @relation(fields: [patternSignalId], references: [id], onDelete: SetNull)
  experiment    Experiment?     @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([patternSignalId])
  @@index([experimentId])
  @@index([eventType, occurredAt])
}

model Experiment {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  status          String   @default("DRAFT") // DRAFT | RUNNING | PAUSED | COMPLETED
  variants        Json     // [{key, weight}] weights sum to 1
  guardrailConfig Json     // {maxOriginalityDeviation, minDiversity, maxAttributionViolations}
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())

  assignments  ExperimentAssignment[]
  behaviorEvents BehaviorEvent[]

  @@index([status])
}

model ExperimentAssignment {
  id           String   @id @default(cuid())
  experimentId String
  subjectKey   String
  variant      String
  assignedAt   DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, subjectKey])
  @@index([experimentId])
}

model RankingScore {
  id              String    @id @default(cuid())
  itemId          String    @unique
  rawScore        Float
  decayedScore    Float
  qualityScore    Float
  recencyScore    Float
  finalRankScore  Float
  lastComputedAt  DateTime
  createdAt       DateTime  @default(now())

  item GalleryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model SignalScore {
  id                   String   @id @default(cuid())
  patternSignalId      String   @unique
  suggestionStrength   Float
  explanationReasonCode String
  lastComputedAt       DateTime
  createdAt            DateTime @default(now())

  patternSignal PatternSignal @relation(fields: [patternSignalId], references: [id], onDelete: Cascade)
}

// ── Provenance Models (ADR-0003) ─────────────────────────────────────────

model Creator {
  id                 String   @id @default(cuid())
  name               String
  url                String?
  verificationStatus String   @default("UNVERIFIED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  attributions    Attribution[]
  sourceRecords   SourceRecord[]
  ownershipClaims OwnershipClaim[]
}

model SourceRecord {
  id           String   @id @default(cuid())
  sourceUrl    String
  canonicalUrl String   @unique
  captureMode  String
  capturedAt   DateTime
  evidenceHash String?
  createdAt    DateTime @default(now())

  creator      Creator?      @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId    String?
  galleryItem  GalleryItem?

  @@index([creatorId])
  @@index([captureMode])
}

model AiProvenance {
  id               String   @id @default(cuid())
  provider         String
  modelName        String
  generatedAt      DateTime
  disclosureStatus String   // HUMAN | AI_ASSISTED | AI_GENERATED | UNKNOWN
  promptHash       String?
  outputHash       String?
  createdAt        DateTime @default(now())

  galleryItem  GalleryItem?

  @@index([disclosureStatus])
}

model OwnershipClaim {
  id              String    @id @default(cuid())
  itemId          String
  claimantName    String
  claimantContact String
  status          String    @default("PENDING") // PENDING | UNDER_REVIEW | ACCEPTED | REJECTED | WITHDRAWN
  submittedAt     DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  createdAt       DateTime  @default(now())

  item      GalleryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  creator   Creator?    @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  creatorId String?

  @@index([status])
  @@index([itemId])
}

model RemovalRecord {
  id          String   @id @default(cuid())
  itemId      String
  status      String   @default("REQUESTED") // REQUESTED | EFFECTIVE | COMPLETED
  requestedBy String
  reason      String
  requestedAt DateTime @default(now())
  effectiveAt DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  item   GalleryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, status])
  @@index([status])
}

// ADR-0003 D5: attribution corrections are recorded as superseding assertions;
// the historical attribution/assertion rows are never mutated (R3 immutability).
model SupersedingAssertion {
  id                   String   @id @default(cuid())
  targetItemId         String
  replacesAssertionId  String
  correctedCreatorId   String?
  correctedLicenseType String? // LicenceId string (evolving vocabulary, no DB enum)
  rationale            String
  recordedBy           String
  recordedAt           DateTime
  createdAt            DateTime @default(now())

  targetItem GalleryItem @relation(fields: [targetItemId], references: [id], onDelete: Restrict)

  @@index([targetItemId])
  @@index([recordedAt])
}

// Section library safe reference (ADR-0008 D2): first-class section records.
// Additive, curated metadata only - never raw content/structure/DOM. Crops are
// pre-generated HTTPS references; lessons/notes are bounded curator-authored
// descriptors. itemId FK is Restrict (durable, no cascade).
model SectionRecord {
  id              String    @id @default(cuid())
  sectionType     String // validated against the closed taxonomy in domain (ADR-0008 D1)
  title           String
  desktopCropUrl  String?
  mobileCropUrl   String?
  lessons         Json?
  doNotCopyNote   String?
  itemId          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  item GalleryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([sectionType])
  @@index([itemId])
}
